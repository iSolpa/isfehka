<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HKA credentials on the single neutral FE settings page: injected into
         the base's driver extension anchor (isfe_settings_extra). -->
    <record id="res_config_settings_view_form_isfehka" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.isfehka</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="isfe_base.res_config_settings_view_form_isfe"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='isfe_settings_extra']" position="inside">
                <setting string="HKA Token Empresa"
                         help="Token provisto por The Factory HKA para identificar la empresa.">
                    <field name="hka_token_empresa" password="True"/>
                </setting>
                <setting string="HKA Token Password"
                         help="Contraseña asociada al token de la empresa en HKA.">
                    <field name="hka_token_password" password="True"/>
                </setting>
                <setting string="HKA WSDL URL"
                         help="URL del servicio SOAP de HKA (demo o producción).">
                    <field name="hka_wsdl_url"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
